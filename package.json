{
  "name": "keep-it-real",
  "productName": "Keep It Real",
  "version": "0.1.0",
  "description": "Local-only desktop planner that puts your plan and what actually happened on one shared timeline.",
  "license": "MIT",
  "author": "Keep It Real contributors",
  "private": false,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && node scripts/electron.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "install:local": "node scripts/install-local.mjs",
    "install:local:skip-build": "node scripts/install-local.mjs --skip-build",
    "uninstall:local": "node scripts/install-local.mjs --uninstall"
  },
  "keywords": [
    "electron",
    "calendar",
    "planner",
    "local-first",
    "offline"
  ],
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
